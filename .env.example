# Copy this file to .env and enter your Snowflake connection values.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RESQ_DB
SNOWFLAKE_SCHEMA=PUBLIC
# Set this to a Cortex model enabled in your Snowflake account and region.
SNOWFLAKE_CORTEX_MODEL=llama3.1-70b
